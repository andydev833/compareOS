---
/**
 * RankingPage.astro
 * JSON駆動市場の "ranking" ページ（市場トップ / pages.json の slug:"/"）
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ComparisonTable from '../components/market/ComparisonTable.astro';
import CompanyCard from '../components/company/CompanyCard.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import UpdateNotice from '../components/ui/UpdateNotice.astro';
import CorrectionCTA from '../components/ui/CorrectionCTA.astro';
import AdvertisingCTA from '../components/ui/AdvertisingCTA.astro';
import RelatedPages from '../components/ui/RelatedPages.astro';
import SourceList from '../components/ui/SourceList.astro';
import type { Company } from '../data/types.js';
import type { SimpleMarket } from '../lib/loadMarkets.js';
import type { PageJson } from '../lib/marketSchema.js';
import { getMarketItemListSchema, getFAQSchema } from '../utils/seo.js';
import { pagePath } from '../lib/pagePath.js';

export interface Props {
  market: SimpleMarket;
  companies: Company[];
  pages: PageJson[];
  page: Extract<PageJson, { type: 'ranking' }>;
}

const { market, companies, pages, page } = Astro.props;

const breadcrumbItems = [
  { name: 'ホーム', href: '/' },
  { name: market.shortName, href: `/${market.slug}/` },
];

const jsonLd = [getMarketItemListSchema(market, companies), ...(page.faqs.length > 0 ? [getFAQSchema(page.faqs)] : [])];
---

<BaseLayout
  title={page.title}
  description={page.description || market.description}
  canonical={pagePath(market.slug, page.slug)}
  jsonLd={jsonLd}
  noindex={!page.index}
>
  <SiteHeader slot="header" />

  <div class="container">
    <Breadcrumbs items={breadcrumbItems} />
  </div>

  <section class="market-hero">
    <div class="container">
      <div class="market-hero__meta">
        <span class="market-hero__count">掲載 {companies.length} 社</span>
      </div>
      <h1 class="market-hero__heading">{page.h1}</h1>
      <p class="market-hero__catch">{market.catchCopy}</p>
      <p class="market-hero__sub">{market.subCopy}</p>
      {page.intro && <p class="market-hero__sub">{page.intro}</p>}
      {companies.length > 0 && (
        <div class="market-hero__cta">
          <a href="#comparison-table" class="btn btn--primary">比較表を見る</a>
        </div>
      )}
    </div>
  </section>

  {companies.length > 0 ? (
    <>
      <section class="section" id="comparison-table">
        <div class="container">
          <h2 class="section-title">主要比較表</h2>
          <p class="section-subtitle">公式サイト等の公開情報を基に整理しています。</p>
          <ComparisonTable
            companies={companies}
            comparisonItems={market.comparisonItems}
            marketSlug={market.slug}
            caption={`${market.name} 主要比較表（公開情報に基づく）`}
          />
        </div>
      </section>

      <section class="section section--muted">
        <div class="container">
          <h2 class="section-title">掲載企業一覧</h2>
          <div class="companies-list">
            {companies.map((company) => (
              <CompanyCard company={company} marketSlug={market.slug} showCompareCheckbox={false} />
            ))}
          </div>
        </div>
      </section>
    </>
  ) : (
    <section class="section">
      <div class="container">
        <p class="section-subtitle">現在調査中です。掲載企業が確定次第、順次追加します。</p>
      </div>
    </section>
  )}

  {page.faqs.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-title">よくある質問</h2>
        <FAQAccordion faqs={page.faqs} />
      </div>
    </section>
  )}

  <section class="section section--muted">
    <div class="container">
      <UpdateNotice checkedDate={market.checkedDate} />
      <div style="margin-top: var(--space-5)">
        <SourceList companies={companies} />
      </div>
      <div style="margin-top: var(--space-5)">
        <RelatedPages pages={pages} marketSlug={market.slug} currentSlug={page.slug} />
      </div>
      <div style="margin-top: var(--space-5)">
        <CorrectionCTA marketName={market.name} />
      </div>
      <div style="margin-top: var(--space-4)">
        <AdvertisingCTA />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
.market-hero {
  background: linear-gradient(160deg, hsl(215, 55%, 20%) 0%, hsl(215, 40%, 30%) 100%);
  color: white;
  padding-block: var(--space-10) var(--space-12);
}

.market-hero__meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.market-hero__count {
  font-size: var(--font-size-xs);
  color: hsl(215, 40%, 70%);
  background-color: rgba(255, 255, 255, 0.1);
  padding: 2px 8px;
  border-radius: 4px;
}

.market-hero__heading {
  font-size: var(--font-size-2xl);
  color: white;
  margin-bottom: var(--space-3);
}

@media (min-width: 768px) {
  .market-hero__heading {
    font-size: var(--font-size-3xl);
  }
}

.market-hero__catch {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: hsl(215, 80%, 85%);
  margin-bottom: var(--space-3);
}

.market-hero__sub {
  color: hsl(215, 40%, 75%);
  line-height: 1.7;
  margin-bottom: var(--space-5);
}

.market-hero__cta {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.companies-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}
</style>
