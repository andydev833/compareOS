---
/**
 * MarketCard.astro
 * トップページの市場カード
 */
import type { Market } from '../../data/types.js';

export interface Props {
  market: Market;
}

const { market } = Astro.props;

const categoryColors: Record<string, string> = {
  equipment: 'var(--color-cat-equipment)',
  office: 'var(--color-cat-office)',
  'hr-marketing': 'var(--color-cat-hr)',
};

const categoryLabels: Record<string, string> = {
  equipment: '設備・施工',
  office: 'オフィス・施設',
  'hr-marketing': '人材・集客',
};

const categoryColor = categoryColors[market.category] || 'var(--color-primary)';
---

<article class="market-card" style={`--cat-color: ${categoryColor}`}>
  <div class="market-card__category">
    <span>{categoryLabels[market.category]}</span>
  </div>

  <div class="market-card__body">
    <h3 class="market-card__name">{market.shortName}</h3>
    <p class="market-card__description">{market.description.slice(0, 80)}…</p>

    <div class="market-card__meta">
      <div class="market-card__meta-item">
        <span class="market-card__meta-label">主な利用者</span>
        <span class="market-card__meta-value">{market.targetUsers[0]}</span>
      </div>
      <div class="market-card__meta-item">
        <span class="market-card__meta-label">比較できる項目</span>
        <span class="market-card__meta-value">{market.comparisonItems.slice(0, 3).join('・')}など</span>
      </div>
      <div class="market-card__meta-item">
        <span class="market-card__meta-label">掲載企業</span>
        <span class="market-card__meta-value">{market.companyCount}社</span>
      </div>
    </div>
  </div>

  <div class="market-card__footer">
    <a href={`/${market.slug}/`} class="btn btn--primary btn--sm">
      会社を比較する
    </a>
  </div>
</article>

<style>
.market-card {
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-top: 3px solid var(--cat-color);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow var(--transition), transform var(--transition);
}

.market-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.market-card__category {
  padding: var(--space-3) var(--space-5);
  background-color: var(--color-bg-subtle);
  border-bottom: 1px solid var(--color-border);
}

.market-card__category span {
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--cat-color);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.market-card__body {
  padding: var(--space-5);
  flex: 1;
}

.market-card__name {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.market-card__description {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
  margin-bottom: var(--space-4);
}

.market-card__meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.market-card__meta-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.market-card__meta-label {
  font-size: 10px;
  font-weight: 700;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.market-card__meta-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.market-card__footer {
  padding: var(--space-4) var(--space-5);
  border-top: 1px solid var(--color-border);
}
</style>
