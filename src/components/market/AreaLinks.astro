---
/**
 * AreaLinks.astro
 * 同一市場内のエリア別ページへのリンク一覧
 */
import type { PageJson } from '../../lib/marketSchema.js';

export interface Props {
  pages: PageJson[];
  marketSlug: string;
  currentAreaName?: string;
}

const { pages, marketSlug, currentAreaName } = Astro.props;

const areaPages = pages.filter((p): p is Extract<PageJson, { type: 'area' }> => p.type === 'area');
---

{areaPages.length > 0 && (
  <nav class="area-links" aria-label="エリアから探す">
    <p class="area-links__label">エリアから探す</p>
    <ul>
      {areaPages.map((page) => (
        <li>
          <a
            href={`/${marketSlug}${page.slug}`}
            class={`area-links__link ${page.areaName === currentAreaName ? 'is-current' : ''}`}
            aria-current={page.areaName === currentAreaName ? 'page' : undefined}
          >
            {page.areaName}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
.area-links__label {
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-3);
}

.area-links ul {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.area-links__link {
  display: inline-flex;
  padding: var(--space-1) var(--space-3);
  background-color: var(--color-bg-subtle);
  border: 1px solid var(--color-border);
  border-radius: 100px;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  text-decoration: none;
}

.area-links__link:hover {
  background-color: var(--color-primary-pale);
  color: var(--color-primary);
  text-decoration: none;
}

.area-links__link.is-current {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: white;
}
</style>
