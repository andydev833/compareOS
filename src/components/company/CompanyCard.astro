---
/**
 * CompanyCard.astro
 * 企業カード（一覧ページ用）
 */
import type { Company } from '../../data/types.js';
import ListingTypeBadge from '../ui/ListingTypeBadge.astro';
import { getInfoStatusClass } from '../../utils/filters.js';

export interface Props {
  company: Company;
  marketSlug: string;
  showCompareCheckbox?: boolean;
}

const { company, marketSlug, showCompareCheckbox = true } = Astro.props;

// 主要比較項目（最大5件表示）
const mainItems = Object.entries(company.comparisonData).slice(0, 5);
---

<article
  class={`company-card ${company.listingType === 'pr' ? 'company-card--pr' : ''}`}
  data-company-id={company.id}
  data-market={marketSlug}
>
  <!-- ヘッダー -->
  <div class="company-card__header">
    <div class="company-card__title-row">
      <div class="company-card__badges">
        <ListingTypeBadge type={company.listingType} />
      </div>
      {showCompareCheckbox && (
        <label class="company-card__compare-label">
          <input
            type="checkbox"
            class="compare-checkbox"
            value={company.id}
            aria-label={`${company.name}を比較対象に追加`}
            data-company-name={company.name}
          />
          <span>比較対象に追加</span>
        </label>
      )}
    </div>
    <h2 class="company-card__name">{company.name}</h2>
    <p class="company-card__location">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
      </svg>
      {company.region.headquarters}
    </p>
    <p class="company-card__regions">
      対応地域：{company.region.prefectures.join('・')}
      {company.region.wideAreaKansai && (
        <span class="company-card__wide-badge">関西広域</span>
      )}
    </p>
  </div>

  <!-- 概要 -->
  <div class="company-card__body">
    <p class="company-card__overview">{company.overview}</p>

    <!-- 特徴 -->
    {company.features.length > 0 && (
      <ul class="company-card__features" aria-label="主な特徴">
        {company.features.map((feature) => (
          <li class="company-card__feature">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="var(--color-primary-light)" stroke-width="2"/>
              <path d="M8 12l3 3 5-5" stroke="var(--color-primary-light)" stroke-width="2" stroke-linecap="round"/>
            </svg>
            {feature}
          </li>
        ))}
      </ul>
    )}

    <!-- 主要比較項目 -->
    <div class="company-card__comparison">
      <p class="company-card__comparison-label">主要比較項目</p>
      <dl class="company-card__comparison-grid">
        {mainItems.map(([key, value]) => (
          <>
            <dt>{key}</dt>
            <dd class={`status ${getInfoStatusClass(value)}`}>{value}</dd>
          </>
        ))}
      </dl>
    </div>

    <!-- 情報確認日 -->
    <p class="company-card__checked">
      <time datetime={company.sources[0]?.checkedDate}>
        情報確認日：{company.sources[0]?.checkedDate}
      </time>
    </p>
  </div>

  <!-- フッター -->
  <div class="company-card__footer">
    <a
      href={`/${marketSlug}/company/${company.slug}/`}
      class="btn btn--secondary"
      aria-label={`${company.name}の詳細を見る`}
    >
      詳細を見る
    </a>
    <a
      href={company.officialUrl}
      class="btn btn--ghost btn--sm btn--external"
      target="_blank"
      rel="noopener noreferrer"
      data-market-id={marketSlug}
      data-company-id={company.id}
      data-listing-type={company.listingType}
      aria-label={`${company.name}の公式サイトへ（外部サイトへ移動します）`}
    >
      公式サイト
    </a>
  </div>
</article>

<style>
.company-card {
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  transition: box-shadow var(--transition);
}

.company-card:hover {
  box-shadow: var(--shadow-md);
}

.company-card--pr {
  border-color: hsl(35, 60%, 80%);
  border-left: 4px solid var(--color-pr);
}

.company-card__header {
  padding: var(--space-5) var(--space-6);
  border-bottom: 1px solid var(--color-border);
  background-color: var(--color-bg-subtle);
}

.company-card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-2);
}

.company-card__badges {
  display: flex;
  gap: var(--space-2);
}

.company-card__compare-label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  cursor: pointer;
  user-select: none;
}

.company-card__compare-label input[type="checkbox"] {
  width: 16px;
  height: 16px;
  cursor: pointer;
  accent-color: var(--color-primary);
}

.company-card__name {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.company-card__location,
.company-card__regions {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  display: flex;
  align-items: flex-start;
  gap: var(--space-1);
  flex-wrap: wrap;
  line-height: 1.5;
  margin-bottom: var(--space-1);
}

.company-card__wide-badge {
  display: inline-flex;
  padding: 1px 6px;
  background-color: var(--color-primary-pale);
  color: var(--color-primary);
  border-radius: 3px;
  font-size: 11px;
  font-weight: 600;
  margin-left: var(--space-1);
}

.company-card__body {
  padding: var(--space-5) var(--space-6);
}

.company-card__overview {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: var(--space-4);
}

.company-card__features {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.company-card__feature {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.company-card__comparison {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background-color: var(--color-bg-subtle);
  border-radius: var(--border-radius);
}

.company-card__comparison-label {
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-3);
}

.company-card__comparison-grid {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-2) var(--space-3);
  align-items: center;
}

.company-card__comparison-grid dt {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  white-space: nowrap;
}

.company-card__comparison-grid dd {
  font-size: var(--font-size-xs);
}

.company-card__checked {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

.company-card__footer {
  padding: var(--space-4) var(--space-6);
  border-top: 1px solid var(--color-border);
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}
</style>
