---
/**
 * RelatedPages.astro
 * 同一市場内の他ページ（ranking/comparison/area/guide）への内部リンク
 */
import type { PageJson } from '../../lib/marketSchema.js';

export interface Props {
  pages: PageJson[];
  marketSlug: string;
  currentSlug: string;
}

const { pages, marketSlug, currentSlug } = Astro.props;

const TYPE_LABEL: Record<PageJson['type'], string> = {
  ranking: '比較トップ',
  comparison: '比較',
  area: 'エリア',
  guide: 'ガイド',
};

function pagePath(slug: string): string {
  return slug === '/' ? `/${marketSlug}/` : `/${marketSlug}${slug}`;
}

const related = pages.filter((p) => p.slug !== currentSlug);
---

{related.length > 0 && (
  <nav class="related-pages" aria-label="関連ページ">
    <p class="related-pages__label">関連ページ</p>
    <ul>
      {related.map((page) => (
        <li>
          <span class="related-pages__type">{TYPE_LABEL[page.type]}</span>
          <a href={pagePath(page.slug)}>{page.h1}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
.related-pages__label {
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-3);
}

.related-pages ul {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.related-pages li {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-size-sm);
}

.related-pages__type {
  flex-shrink: 0;
  padding: 1px 8px;
  background-color: var(--color-bg-subtle);
  border-radius: 100px;
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}
</style>
