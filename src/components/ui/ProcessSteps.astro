---
/**
 * ProcessSteps.astro
 * 依頼の流れ（ステップ表示）
 */
import type { ProcessStep } from '../../data/types.js';

export interface Props {
  steps: ProcessStep[];
  title?: string;
}

const { steps, title = '依頼の流れ' } = Astro.props;
---

<div class="process-steps">
  {title && <h3 class="process-steps__title">{title}</h3>}
  <ol class="process-steps__list" role="list">
    {steps.map((step) => (
      <li class="process-steps__item">
        <div class="process-steps__number" aria-hidden="true">{step.step}</div>
        <div class="process-steps__content">
          <p class="process-steps__step-title">{step.title}</p>
          <p class="process-steps__step-desc">{step.description}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
.process-steps__title {
  font-size: var(--font-size-md);
  font-weight: 700;
  margin-bottom: var(--space-5);
}

.process-steps__list {
  display: flex;
  flex-direction: column;
  gap: 0;
  position: relative;
}

.process-steps__item {
  display: flex;
  gap: var(--space-4);
  position: relative;
  padding-bottom: var(--space-6);
}

.process-steps__item:last-child {
  padding-bottom: 0;
}

/* 縦線 */
.process-steps__item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 19px;
  top: 40px;
  bottom: 0;
  width: 2px;
  background-color: var(--color-border);
}

.process-steps__number {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-base);
  font-weight: 700;
  z-index: 1;
}

.process-steps__content {
  padding-top: var(--space-2);
}

.process-steps__step-title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-1);
}

.process-steps__step-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.65;
}
</style>
