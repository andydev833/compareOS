---
/**
 * 業務用エアコン - 費用ページ
 * /commercial-aircon/cost/
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/layout/SiteHeader.astro';
import SiteFooter from '../../../components/layout/SiteFooter.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import CostSummary from '../../../components/ui/CostSummary.astro';
import FAQAccordion from '../../../components/ui/FAQAccordion.astro';
import { marketsBySlug } from '../../../data/markets.js';
import { getArticleSchema } from '../../../utils/seo.js';

const market = marketsBySlug['commercial-aircon'];
const costFaqs = market.faqs.filter((f) =>
  f.question.includes('費用') || f.question.includes('相場') || f.question.includes('安く')
);

const breadcrumbs = [
  { name: 'ホーム', href: '/' },
  { name: market.shortName, href: `/${market.slug}/` },
  { name: '費用について', href: `/${market.slug}/cost/` },
];
---

<BaseLayout
  title={`業務用エアコン工事の費用｜大阪 | compareOS`}
  description={`大阪の業務用エアコン工事の費用構成・見積もり時の確認ポイントを解説。具体的な金額は現地調査・見積もりが必要です。`}
  canonical={`/${market.slug}/cost/`}
  jsonLd={getArticleSchema({
    title: '業務用エアコン工事の費用について',
    description: '費用を左右する条件、追加費用の発生ポイント、見積もり時の確認事項を整理',
    url: `/${market.slug}/cost/`,
    dateModified: market.checkedDate,
  })}
>
  <SiteHeader slot="header" />
  <div class="container" style="padding-block: var(--space-4)">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <div class="container" style="padding-block: var(--space-10); max-width: 860px">
    <h1>業務用エアコン工事の費用について</h1>
    <p class="page-desc">
      業務用エアコン工事の費用は、機器の種類・設置状況・対応地域・会社によって大きく異なります。
      このページでは費用を構成する要素と、見積もり時の確認ポイントを整理します。
      具体的な費用は、必ず現地調査・見積もりを取得してください。
    </p>

    <div class="info-notice" style="margin-bottom: var(--space-8)">
      <strong>重要：</strong>このページに具体的な金額は掲載しません。
      掲載企業の公式サイトで価格情報が確認できず、根拠のある価格帯を提示できないためです。
      現地調査・見積もりを複数社から取得して比較することを推奨します。
    </div>

    <section style="margin-bottom: var(--space-10)">
      <h2>費用の構成要素</h2>
      <CostSummary costInfo={market.costInfo} marketName={market.name} />
    </section>

    <section style="margin-bottom: var(--space-10)">
      <h2>見積もりを取る前の準備</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-5)">
        現地調査・見積もりをスムーズに進めるために、以下の情報を事前に整理しておくことを推奨します。
      </p>
      <div class="prep-grid">
        {[
          { title: '現在の設備状況', items: ['設置済み機器のメーカー・型番', '設置年数（おおよそ）', '現在の不具合の症状'] },
          { title: '設置環境', items: ['設置場所の種類（店舗・オフィス・工場等）', '床面積（㎡）', '天井高', '電源種別（単相・三相）'] },
          { title: '希望条件', items: ['希望するサービス内容（新設・交換・修理）', '対応希望時期', '予算感（ある場合）'] },
        ].map((item) => (
          <div class="prep-card">
            <h3 class="prep-card__title">{item.title}</h3>
            <ul>
              {item.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {costFaqs.length > 0 && (
      <section style="margin-bottom: var(--space-10)">
        <h2>費用に関するよくある質問</h2>
        <FAQAccordion faqs={costFaqs} />
        <p style="margin-top: var(--space-4)">
          <a href={`/${market.slug}/faq/`}>すべての質問を見る →</a>
        </p>
      </section>
    )}

    <div style="padding-top: var(--space-6); border-top: 1px solid var(--color-border)">
      <a href={`/${market.slug}/`} class="btn btn--secondary">← {market.shortName}の比較ページに戻る</a>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
h1 { font-size: var(--font-size-2xl); margin-bottom: var(--space-4); }
h2 { font-size: var(--font-size-xl); margin-bottom: var(--space-4); }
.page-desc { color: var(--color-text-secondary); line-height: 1.75; margin-bottom: var(--space-5); }

.prep-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-5); }
@media (min-width: 640px) { .prep-grid { grid-template-columns: repeat(3, 1fr); } }

.prep-card { padding: var(--space-5); background-color: var(--color-bg-subtle); border: 1px solid var(--color-border); border-radius: var(--border-radius-lg); }
.prep-card__title { font-size: var(--font-size-base); font-weight: 700; color: var(--color-text); margin-bottom: var(--space-3); }
.prep-card ul { display: flex; flex-direction: column; gap: var(--space-2); }
.prep-card li { font-size: var(--font-size-sm); color: var(--color-text-secondary); padding-left: var(--space-4); position: relative; line-height: 1.5; }
.prep-card li::before { content: '□'; position: absolute; left: 0; color: var(--color-primary-light); }
</style>
