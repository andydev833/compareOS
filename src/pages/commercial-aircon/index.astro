---
/**
 * 業務用エアコン市場トップページ
 * /commercial-aircon/
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import DirectAnswerBlock from '../../components/market/DirectAnswerBlock.astro';
import FilterPanel from '../../components/market/FilterPanel.astro';
import ComparisonTable from '../../components/market/ComparisonTable.astro';
import CompanyCard from '../../components/company/CompanyCard.astro';
import ProcessSteps from '../../components/ui/ProcessSteps.astro';
import CostSummary from '../../components/ui/CostSummary.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import CorrectionCTA from '../../components/ui/CorrectionCTA.astro';
import AdvertisingCTA from '../../components/ui/AdvertisingCTA.astro';
import UpdateNotice from '../../components/ui/UpdateNotice.astro';
import { marketsBySlug } from '../../data/markets.js';
import { airconCompanies } from '../../data/companies/commercial-aircon.js';
import { getMarketItemListSchema, getBreadcrumbSchema, getFAQSchema } from '../../utils/seo.js';
import { getLatestCheckedDate } from '../../utils/dates.js';

const market = marketsBySlug['commercial-aircon'];
const companies = airconCompanies;
const checkedDate = getLatestCheckedDate(companies, market.checkedDate);

const breadcrumbItems = [
  { name: 'ホーム', href: '/' },
  { name: '法人向けサービス', href: '/markets/' },
  { name: market.shortName, href: `/${market.slug}/` },
];

const jsonLd = [
  getMarketItemListSchema(market, companies),
  getFAQSchema(market.faqs),
];
---

<BaseLayout
  title={`${market.h1}｜修理・交換・保守 | compareOS`}
  description={`${market.description}掲載企業${companies.length}社（対応速度・工事内容・保守体制で比較）。`}
  canonical={`/${market.slug}/`}
  jsonLd={jsonLd}
>
  <SiteHeader slot="header" />

  <!-- パンくず -->
  <div class="container">
    <Breadcrumbs items={breadcrumbItems} />
  </div>

  <!-- ヒーロー -->
  <section class="market-hero" aria-labelledby="market-hero-heading">
    <div class="container">
      <div class="market-hero__inner">
        <div class="market-hero__content">
          <div class="market-hero__meta">
            <span class="market-hero__category">設備・施工</span>
            <span class="market-hero__count">掲載 {companies.length} 社</span>
          </div>
          <h1 class="market-hero__heading" id="market-hero-heading">{market.h1}</h1>
          <p class="market-hero__catch">{market.catchCopy}</p>
          <p class="market-hero__sub">{market.subCopy}</p>

          <dl class="market-hero__details">
            <div>
              <dt>対象地域</dt>
              <dd>{market.targetRegion}</dd>
            </div>
            <div>
              <dt>情報確認日</dt>
              <dd>
                <time datetime={checkedDate}>{checkedDate}</time>
              </dd>
            </div>
          </dl>

          <div class="market-hero__cta">
            <a href="#comparison-table" class="btn btn--primary">比較表を見る</a>
            <a href={`/${market.slug}/companies/`} class="btn btn--secondary">条件から探す</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- よくある課題 -->
  <section class="section section--muted" aria-labelledby="problems-heading">
    <div class="container">
      <h2 class="section-title" id="problems-heading">業務用エアコンでよくある課題</h2>
      <div class="grid-2">
        {market.problems.map((problem) => (
          <div class="problem-card">
            <h3 class="problem-card__title">{problem.title}</h3>
            <p class="problem-card__desc">{problem.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 会社選びの結論 -->
  <section class="section" aria-labelledby="conclusion-heading">
    <div class="container">
      <h2 class="section-title" id="conclusion-heading">業務用エアコン会社の選び方</h2>
      <p class="section-subtitle">まず、結論から確認してください。</p>
      <DirectAnswerBlock
        summary={market.selectionConclusion.summary}
        reasons={market.selectionConclusion.reasons}
        checkItems={market.selectionConclusion.checkItems}
        cautions={market.selectionConclusion.cautions}
      />
    </div>
  </section>

  <!-- 主要比較表 -->
  <section class="section section--muted" aria-labelledby="comparison-heading" id="comparison-table">
    <div class="container">
      <h2 class="section-title" id="comparison-heading">主要比較表</h2>
      <p class="section-subtitle">
        公式サイト等の公開情報を基に整理しています。「公式サイトで確認できず」は情報が見つからなかったことを示します。
        詳しい調査方法は<a href="/methodology/">調査・比較方針</a>をご覧ください。
      </p>
      <ComparisonTable
        companies={companies}
        comparisonItems={market.comparisonItems}
        marketSlug={market.slug}
        caption="大阪の業務用エアコン工事会社 主要比較表（公開情報に基づく）"
      />
      <div style="margin-top: var(--space-6)">
        <a href={`/${market.slug}/companies/`} class="btn btn--primary">企業一覧・絞り込みで探す</a>
      </div>
    </div>
  </section>

  <!-- 条件別の企業紹介 -->
  <section class="section" aria-labelledby="condition-heading">
    <div class="container">
      <h2 class="section-title" id="condition-heading">確認できた条件から探す</h2>
      <p class="section-subtitle">
        以下は「おすすめ」や「ランキング」ではなく、公式情報で確認できた条件の整理です。
      </p>

      <div class="condition-groups">
        <div class="condition-group">
          <h3 class="condition-group__title">緊急対応を公式情報で確認できる会社</h3>
          <div class="condition-group__companies">
            {companies.filter((c) => c.comparisonData['緊急対応'] === '対応').map((company) => (
              <div class="condition-company">
                <a href={`/${market.slug}/company/${company.slug}/`} class="condition-company__name">
                  {company.name}
                </a>
                <span class="condition-company__region">
                  {company.region.prefectures.join('・')}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="condition-group">
          <h3 class="condition-group__title">保守契約への対応を確認できる会社</h3>
          <div class="condition-group__companies">
            {companies.filter((c) => c.comparisonData['保守契約'] === '対応').map((company) => (
              <div class="condition-company">
                <a href={`/${market.slug}/company/${company.slug}/`} class="condition-company__name">
                  {company.name}
                </a>
                <span class="condition-company__region">
                  {company.region.prefectures.join('・')}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="condition-group">
          <h3 class="condition-group__title">関西広域への対応を確認できる会社</h3>
          <div class="condition-group__companies">
            {companies.filter((c) => c.region.wideAreaKansai).map((company) => (
              <div class="condition-company">
                <a href={`/${market.slug}/company/${company.slug}/`} class="condition-company__name">
                  {company.name}
                </a>
                <span class="condition-company__region">
                  {company.region.prefectures.join('・')}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 掲載企業一覧 -->
  <section class="section section--muted" aria-labelledby="companies-heading">
    <div class="container">
      <h2 class="section-title" id="companies-heading">掲載企業一覧</h2>
      <p class="section-subtitle">
        掲載企業は各社公式サイト等の公開情報に基づいて整理しています。PRバッジは広告掲載（有料）企業を示します。
      </p>

      <div class="companies-layout">
        <!-- フィルタサイドバー -->
        <aside class="companies-layout__sidebar" aria-label="絞り込み">
          <FilterPanel filterOptions={market.filterOptions} companyCount={companies.length} />
        </aside>

        <!-- 企業リスト -->
        <div class="companies-layout__main">
          <div class="companies-list" id="companies-list">
            {companies.map((company) => (
              <CompanyCard company={company} marketSlug={market.slug} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 費用概要 -->
  <section class="section" aria-labelledby="cost-heading">
    <div class="container">
      <h2 class="section-title" id="cost-heading">業務用エアコン工事の費用について</h2>
      <p class="section-subtitle">
        費用は設置状況・工事内容・会社によって異なります。必ず現地調査・見積もりを取得してください。
      </p>
      <CostSummary costInfo={market.costInfo} marketName={market.name} />
      <div style="margin-top: var(--space-6)">
        <a href={`/${market.slug}/cost/`} class="btn btn--secondary">費用の詳細を確認する</a>
      </div>
    </div>
  </section>

  <!-- 依頼の流れ -->
  <section class="section section--muted" aria-labelledby="process-heading">
    <div class="container">
      <h2 class="section-title" id="process-heading">業務用エアコン工事の依頼の流れ</h2>
      <ProcessSteps steps={market.processSteps} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <h2 class="section-title" id="faq-heading">よくある質問</h2>
      <p class="section-subtitle">
        各質問の最初の1〜2文が直接回答です。その後に条件・例外・注意点を説明します。
      </p>
      <FAQAccordion faqs={market.faqs} />
      <div style="margin-top: var(--space-6)">
        <a href={`/${market.slug}/faq/`} class="btn btn--secondary">すべての質問を見る</a>
      </div>
    </div>
  </section>

  <!-- 調査方法と免責 -->
  <section class="section section--muted" aria-labelledby="methodology-heading">
    <div class="container">
      <h2 class="section-title" id="methodology-heading">調査方法と掲載基準</h2>
      <UpdateNotice checkedDate={checkedDate} />
      <div class="methodology-links">
        <a href="/methodology/">調査・比較方針を読む</a>
        <span class="text-muted">｜</span>
        <a href="/advertising-policy/">広告掲載ポリシー</a>
        <span class="text-muted">｜</span>
        <a href="/disclaimer/">免責事項</a>
      </div>
      <div style="margin-top: var(--space-6)">
        <CorrectionCTA marketName={market.name} />
      </div>
      <div style="margin-top: var(--space-4)">
        <AdvertisingCTA />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
/* 市場ヒーロー */
.market-hero {
  background: linear-gradient(160deg, hsl(215, 55%, 20%) 0%, hsl(215, 40%, 30%) 100%);
  color: white;
  padding-block: var(--space-10) var(--space-12);
}

.market-hero__inner {
  max-width: var(--content-width);
}

.market-hero__meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.market-hero__category {
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: hsl(215, 80%, 75%);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.market-hero__count {
  font-size: var(--font-size-xs);
  color: hsl(215, 40%, 70%);
  background-color: rgba(255,255,255,0.1);
  padding: 2px 8px;
  border-radius: 4px;
}

.market-hero__heading {
  font-size: var(--font-size-2xl);
  color: white;
  margin-bottom: var(--space-3);
  line-height: 1.3;
}

@media (min-width: 768px) {
  .market-hero__heading { font-size: var(--font-size-3xl); }
}

.market-hero__catch {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: hsl(215, 80%, 85%);
  margin-bottom: var(--space-3);
}

.market-hero__sub {
  color: hsl(215, 40%, 75%);
  line-height: 1.7;
  margin-bottom: var(--space-5);
}

.market-hero__details {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4) var(--space-8);
  margin-bottom: var(--space-6);
}

.market-hero__details div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.market-hero__details dt {
  font-size: 10px;
  font-weight: 700;
  color: hsl(215, 40%, 65%);
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.market-hero__details dd {
  font-size: var(--font-size-sm);
  color: hsl(215, 50%, 85%);
}

.market-hero__cta {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

/* よくある課題カード */
.problem-card {
  padding: var(--space-5);
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  border-left: 4px solid var(--color-primary-light);
}

.problem-card__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.problem-card__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.65;
}

/* 条件別企業 */
.condition-groups {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

@media (min-width: 768px) {
  .condition-groups { grid-template-columns: repeat(3, 1fr); }
}

.condition-group {
  padding: var(--space-5);
  background-color: var(--color-bg-subtle);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
}

.condition-group__title {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--color-text-secondary);
  margin-bottom: var(--space-3);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--color-border);
}

.condition-group__companies {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.condition-company {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.condition-company__name {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: none;
}

.condition-company__name:hover {
  text-decoration: underline;
}

.condition-company__region {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
}

/* 企業一覧レイアウト */
.companies-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

@media (min-width: 1024px) {
  .companies-layout {
    grid-template-columns: var(--sidebar-width) 1fr;
    align-items: start;
  }

  .companies-layout__sidebar {
    position: sticky;
    top: 80px;
  }
}

.companies-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

/* 方針リンク */
.methodology-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-3);
  margin-top: var(--space-4);
  font-size: var(--font-size-sm);
}

.methodology-links a {
  color: var(--color-primary-light);
}
</style>
