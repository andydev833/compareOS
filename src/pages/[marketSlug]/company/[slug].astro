---
/**
 * 汎用企業詳細ページ（業務用エアコン以外の11市場）
 * /[marketSlug]/company/[slug]/
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/layout/SiteHeader.astro';
import SiteFooter from '../../../components/layout/SiteFooter.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import ListingTypeBadge from '../../../components/ui/ListingTypeBadge.astro';
import ExternalLinkButton from '../../../components/ui/ExternalLinkButton.astro';
import CorrectionCTA from '../../../components/ui/CorrectionCTA.astro';
import UpdateNotice from '../../../components/ui/UpdateNotice.astro';
import { getInfoStatusClass } from '../../../utils/filters.js';
import { getCompanySchema } from '../../../utils/seo.js';
import { markets, marketsBySlug } from '../../../data/markets.js';
import { companiesByMarket, allCompanies } from '../../../data/companies/other-markets.js';
import { loadJsonMarkets } from '../../../lib/loadMarkets.js';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  const EXCLUDED = ['commercial-aircon'];
  const paths = [];
  for (const market of markets) {
    if (EXCLUDED.includes(market.slug)) continue;
    const companies = companiesByMarket[market.id] || [];
    for (const company of companies) {
      paths.push({
        params: { marketSlug: market.slug, slug: company.slug },
        props: { company, market },
      });
    }
  }
  // JSON駆動市場（markets/*/）の企業も同じ企業詳細テンプレートで生成する
  for (const jm of loadJsonMarkets()) {
    for (const company of jm.companies) {
      paths.push({
        params: { marketSlug: jm.market.slug, slug: company.slug },
        props: { company, market: jm.market },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { company, market } = Astro.props;

const breadcrumbItems = [
  { name: 'ホーム', href: '/' },
  { name: market.shortName, href: `/${market.slug}/` },
  { name: company.name, href: `/${market.slug}/company/${company.slug}/` },
];

const jsonLd = getCompanySchema(company, market);
---

<BaseLayout
  title={`${company.name} - ${market.shortName}｜公式情報に基づく整理 | compareOS`}
  description={`${company.name}の${market.shortName}への対応内容を整理しています。対応地域：${company.region.prefectures.join('・')}。`}
  canonical={`/${market.slug}/company/${company.slug}/`}
  jsonLd={jsonLd}
>
  <SiteHeader slot="header" />

  <div class="container">
    <Breadcrumbs items={breadcrumbItems} />
  </div>

  <!-- 企業ヒーロー -->
  <section class="company-hero">
    <div class="container">
      <div class="company-hero__badges">
        <ListingTypeBadge type={company.listingType} />
        {company.region.wideAreaKansai && (
          <span class="badge badge--standard">関西広域</span>
        )}
      </div>
      <h1 class="company-hero__name">{company.name}</h1>
      <p class="company-hero__location">所在地：{company.region.headquarters}</p>
      <p class="company-hero__overview">{company.overview}</p>

      <div style="margin-bottom: var(--space-4)">
        <ExternalLinkButton
          href={company.officialUrl}
          marketId={market.id}
          companyId={company.id}
          companyName={company.name}
          listingType={company.listingType}
          pageType="company"
          placement="hero"
          label="公式サイトで詳細を確認する"
          size="lg"
        />
      </div>

      {company.listingType === 'pr' && (
        <p class="company-hero__pr-notice">
          ※ この企業は広告掲載（有料）です。<a href="/advertising-policy/">広告掲載ポリシーを確認する</a>
        </p>
      )}
      {company.listingType === 'demo' && (
        <p class="company-hero__demo-notice">⚠️ これはDEMOデータです。実在企業ではありません。</p>
      )}
    </div>
  </section>

  <!-- 詳細 -->
  <div class="container" style="padding-block: var(--space-10)">
    <div class="company-detail-layout">
      <main>
        <!-- 対応サービス -->
        <section class="company-detail-section">
          <h2>対応サービス</h2>
          <ul class="services-list">
            {company.services.map((service) => (
              <li>{service}</li>
            ))}
          </ul>
        </section>

        <!-- 比較データ -->
        <section class="company-detail-section">
          <h2>対応状況（公開情報に基づく）</h2>
          <p class="section-note">
            「公式サイトで確認できず」は非対応ではなく、公開情報から確認できなかったことを示します。
          </p>
          <dl class="comparison-detail-grid">
            {Object.entries(company.comparisonData).map(([key, value]) => (
              <>
                <dt>{key}</dt>
                <dd class={`status ${getInfoStatusClass(value)}`}>{value}</dd>
              </>
            ))}
          </dl>
        </section>

        <!-- 特徴 -->
        {company.features.length > 0 && (
          <section class="company-detail-section">
            <h2>公式情報で確認できた事項</h2>
            <ul class="features-list">
              {company.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- 費用・保証 -->
        <section class="company-detail-section">
          <h2>費用・保証情報</h2>
          <dl class="info-dl">
            <dt>費用情報</dt>
            <dd>{company.priceInfo}</dd>
            <dt>保証情報</dt>
            <dd>{company.warrantyInfo}</dd>
            <dt>実績情報</dt>
            <dd>{company.trackRecord}</dd>
          </dl>
        </section>

        <!-- 情報源 -->
        <section class="company-detail-section">
          <h2>情報元</h2>
          <ul>
            {company.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="link--external">
                  {source.label}
                </a>
                <span class="text-muted text-xs">（確認日：{source.checkedDate}）</span>
              </li>
            ))}
          </ul>
        </section>

        <div style="margin-top: var(--space-8)">
          <UpdateNotice checkedDate={company.sources[0]?.checkedDate} sources={company.sources} />
          <div style="margin-top: var(--space-4)">
            <CorrectionCTA companyName={company.name} />
          </div>
        </div>
      </main>

      <!-- サイドバー -->
      <aside class="company-detail-sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-card__title">公式サイトを確認する</h3>
          <ExternalLinkButton
            href={company.officialUrl}
            marketId={market.id}
            companyId={company.id}
            companyName={company.name}
            listingType={company.listingType}
            pageType="company"
            placement="sidebar"
            label="公式サイトへ"
          />
        </div>
        <div class="sidebar-card">
          <h3 class="sidebar-card__title">対応地域</h3>
          <div class="sidebar-regions">
            {company.region.prefectures.map((pref) => (
              <span class="sidebar-region-tag">{pref}</span>
            ))}
          </div>
        </div>
        <div class="sidebar-card">
          <a href={`/${market.slug}/`} class="btn btn--ghost" style="width: 100%">
            企業一覧に戻る
          </a>
        </div>
      </aside>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
.company-hero {
  background-color: var(--color-bg-section);
  border-bottom: 1px solid var(--color-border);
  padding-block: var(--space-8) var(--space-10);
}

.company-hero__badges {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.company-hero__name {
  font-size: var(--font-size-2xl);
  margin-bottom: var(--space-2);
}

.company-hero__location {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
}

.company-hero__overview {
  color: var(--color-text-secondary);
  line-height: 1.75;
  margin-bottom: var(--space-6);
  max-width: var(--content-width);
}

.company-hero__pr-notice {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  padding: var(--space-2) var(--space-3);
  background-color: hsl(35, 80%, 95%);
  border-radius: var(--border-radius);
  border-left: 3px solid var(--color-pr);
}

.company-hero__demo-notice {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--color-demo);
  padding: var(--space-2) var(--space-3);
  background-color: var(--color-demo-bg);
  border-radius: var(--border-radius);
}

.company-detail-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
}

@media (min-width: 1024px) {
  .company-detail-layout {
    grid-template-columns: 1fr var(--sidebar-width);
    align-items: start;
  }
}

.company-detail-section {
  margin-bottom: var(--space-10);
  padding-bottom: var(--space-10);
  border-bottom: 1px solid var(--color-border);
}

.company-detail-section h2 {
  font-size: var(--font-size-xl);
  margin-bottom: var(--space-4);
}

.section-note {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
  padding: var(--space-2) var(--space-3);
  background-color: var(--color-bg-subtle);
  border-radius: var(--border-radius);
}

.services-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--space-2);
}

.services-list li {
  padding: var(--space-2) var(--space-3);
  background-color: var(--color-bg-subtle);
  border-radius: var(--border-radius);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  border-left: 3px solid var(--color-primary-light);
}

.comparison-detail-grid {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-3) var(--space-6);
  align-items: center;
}

.comparison-detail-grid dt {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.comparison-detail-grid dd {
  font-size: var(--font-size-sm);
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.features-list li {
  padding: var(--space-3) var(--space-4);
  background-color: var(--color-primary-pale);
  border-radius: var(--border-radius);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  border-left: 3px solid var(--color-primary-light);
}

.info-dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-2) var(--space-5);
}

.info-dl dt {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.info-dl dd {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.company-detail-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

@media (min-width: 1024px) {
  .company-detail-sidebar { position: sticky; top: 80px; }
}

.sidebar-card {
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--space-5);
}

.sidebar-card__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-3);
}

.sidebar-regions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.sidebar-region-tag {
  padding: 3px var(--space-3);
  background-color: var(--color-bg-subtle);
  border: 1px solid var(--color-border);
  border-radius: 100px;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}
</style>
