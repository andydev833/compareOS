---
/**
 * 広告掲載ポリシー
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'ホーム', href: '/' },
  { name: '広告掲載ポリシー', href: '/advertising-policy/' },
];
---

<BaseLayout
  title="広告掲載ポリシー | Oppick 大阪の比較メディア"
  description="Oppickの広告掲載（PR掲載）に関するポリシーを説明します。"
  canonical="/advertising-policy/"
>
  <SiteHeader slot="header" />
  <div class="container" style="padding-block: var(--space-4)">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <div class="container page-content" style="max-width: var(--content-width); padding-block: var(--space-10)">
    <h1>広告掲載ポリシー</h1>

    <section class="page-section">
      <h2>このサイトの収益について</h2>
      <p>
        このサイトは、次の収入で運営しています。
      </p>
      <ul class="page-list">
        <li>掲載企業からのPR掲載料（有料掲載）</li>
        <li>広告サービス（ASP）などを通じた、申込・来店・成約などに応じた成果報酬（アフィリエイト）</li>
      </ul>
      <p style="margin-top: var(--space-4)">
        収入が発生する可能性のあるページには、広告を含むことを明示します。
      </p>
    </section>

    <section class="page-section">
      <h2>広告であることの表示</h2>
      <ul class="page-list">
        <li>PR掲載企業には、企業名の隣に「PR」バッジを表示します。閲覧者は常にどの企業がPR掲載かを確認できます</li>
        <li>成果報酬が発生するリンクには、リンクの近くに広告であることを表示し、検索エンジン向けに <code>rel="sponsored"</code> を付けます</li>
      </ul>
    </section>

    <section class="page-section">
      <h2>掲載順と掲載の基準</h2>
      <ul class="page-list">
        <li>掲載順は、報酬の有無・金額、PR掲載の有無、広告サービスとの提携の有無と無関係に、公開した基準で決めます</li>
        <li>基準を定めている市場では、比較表の近くにその基準を表示します。基準の一覧は<a href="/methodology/#ordering">調査・比較方針</a>に掲載しています</li>
        <li>広告サービスと提携していない企業も、同じ基準で掲載します</li>
        <li>掲載基準を満たす企業の掲載を、PR掲載の有無を理由に拒否しません</li>
      </ul>
    </section>

    <section class="page-section">
      <h2>比較情報の扱い</h2>
      <ul class="page-list">
        <li>比較表の内容は、各社の公式サイトの公開情報に基づいて整理します。PR掲載企業も、通常掲載の企業と同じ基準で記載します</li>
        <li>「おすすめ」「No.1」「最安値」など、根拠のない表現は、PR掲載の有無に関わらず使用しません</li>
        <li>掲載情報に誤りがある場合は、<a href="/listing-correction/">掲載情報の修正依頼フォーム</a>から連絡できます</li>
      </ul>
    </section>

    <section class="page-section">
      <h2>PR掲載のお申し込み</h2>
      <p>
        PR掲載をご希望の企業様は、<a href="/advertise/">PR掲載のご相談ページ</a>からお問い合わせください。
        掲載基準を満たす企業様であれば、ご相談をお受けします。
      </p>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
.page-section { margin-bottom: var(--space-10); padding-bottom: var(--space-10); border-bottom: 1px solid var(--color-border); }
.page-section:last-child { border-bottom: none; }
.page-section h2 { font-size: var(--font-size-xl); margin-bottom: var(--space-4); }
.page-section p { color: var(--color-text-secondary); line-height: 1.75; margin-bottom: var(--space-3); }
.page-list { display: flex; flex-direction: column; gap: var(--space-2); }
.page-list li { font-size: var(--font-size-sm); color: var(--color-text-secondary); padding-left: var(--space-5); position: relative; line-height: 1.6; }
.page-list li::before { content: '・'; position: absolute; left: 0; color: var(--color-primary-light); }
h1 { font-size: var(--font-size-2xl); margin-bottom: var(--space-8); }
</style>
